# Usado por app.Dockerfile. O app-start.sh troca ${PORT} pela porta da plataforma.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # API e rotas legadas na mesma origem do frontend: preserva o cookie de sessão.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # O copiloto chama o LLM e pode levar alguns segundos.
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
    }

    location /model-lab/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    # React Router: caminhos de tela que não são arquivos caem no index.html.
    location / {
        try_files $uri /index.html;
    }
}
