# Copie para .env e ajuste. Nenhuma chave real entra no repositório.

# Banco: troque só esta linha para mudar de PostgreSQL para Db2.
DATABASE_URL=postgresql+psycopg://watson:watson@localhost:5432/watson
# DATABASE_URL=db2+ibm_db://watson:senha@localhost:50000/WATSON

# Agentes: "simulated" funciona sem chave; "watsonx" chama o watsonx.ai.
AGENT_PROVIDER=simulated
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Origem do frontend liberada no CORS.
FRONTEND_ORIGIN=http://localhost:5173
