# Copie para .env e ajuste. Nenhuma chave real entra no repositório.

# Banco: troque só esta linha para mudar de PostgreSQL para Db2.
DATABASE_URL=postgresql+psycopg://watson:watson@localhost:5432/watson
# DATABASE_URL=db2+ibm_db://watson:senha@localhost:50000/WATSON

# Agentes: "simulated" funciona sem chave; "watsonx" chama o watsonx.ai.
AGENT_PROVIDER=simulated
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Origem do frontend liberada no CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Política do aviso de compra (docs/arquitetura/decisoes/0004). Valores provisórios.
NOTICE_MEDIUM_THRESHOLD=0.60
NOTICE_HIGH_THRESHOLD=0.80
# "Fui eu" com biometria em aparelho conhecido fecha o caso sozinho? (aguarda o time)
NOTICE_AUTO_CLOSE_ON_IT_WAS_ME=true
# Quanto tempo o agente espera a resposta antes de passar para a analista (hipótese: 10 min, porque as compras do cartão ficam pausadas)
NOTICE_RESPONSE_TIMEOUT_MINUTES=10

# Tentativas simuladas de rajada: só quando velocity_1h (contador do case) alcança o limite.
BURST_VELOCITY_THRESHOLD=10
BURST_MAX_ATTEMPTS=5
BURST_WINDOW_MINUTES=15
BURST_SEED=42

# Modelo de risco: "local" lê outputs/modelo_rf.joblib (precisa do extra risk); "watsonx" chama o deployment online.
RISK_MODEL_PROVIDER=local
# RISK_MODEL_PATH=../../outputs/modelo_rf.joblib
# RISK_DATA_DIR=../../data/processed
RISK_WATSONX_DEPLOYMENT_ID=
# Limiar F2 do notebook 03 (mostrado como referência no Laboratório do modelo).
RISK_DECISION_THRESHOLD=0.817
